# このファイルをコピーして .env.local を作成し、実際の値を入れる（.env.local はコミットしない）。
# 何も設定しなくても起動でき、その場合は熊本想定のサンプルデータが表示される（保存は不可）。
# 手順の詳細は docs/SETUP.md。

# ── データ層（Google Sheets）─────────────────────────────────────────────
# サービスアカウントの client_email
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# 秘密鍵。JSON キーの private_key を、改行を \n に置き換えてダブルクオートで囲む
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...（中略）...\n-----END PRIVATE KEY-----\n"

# 対象スプレッドシートの ID（シート URL の /d/ と /edit の間）
SHEET_ID=your-spreadsheet-id

# ── AI（貼り付け取り込みの解析: テキスト・写真 → 行候補）────────────────
# 未設定の間は取り込み解析が「準備中」表示で安全に停止する。
# ANTHROPIC_API_KEY=sk-ant-...
# 使用モデルを変えたい場合のみ（既定: claude-sonnet-4-6）
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ── 担当者ログイン（個人出し分け）────────────────────────────────────────
# 設定すると全画面ログイン必須になる。パスワードは members タブの password 列（J列）。
# ハッシュ生成: AUTH_SECRET="（同じ値）" node scripts/hash-password.mjs "パスワード"
# AUTH_SECRET=十分に長いランダム文字列をここに
