# Google Sheets 読み取り用サービスアカウント（HANDOFF §7）
# このファイルをコピーして .env.local を作成し、実際の値を入れる（.env.local はコミットしない）

# サービスアカウントの client_email
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# 秘密鍵。JSON キーの private_key を、改行を \n に置き換えてダブルクオートで囲む
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...（中略）...\n-----END PRIVATE KEY-----\n"

# 対象スプレッドシートの ID（シート URL の /d/ と /edit の間）
# シングルテナント運用（1プロジェクト・ログインなし）の場合に設定する。
SHEET_ID=your-spreadsheet-id

# ── マルチテナント（ID＋パスワードでプロジェクトを切り替える）─────────────
# PROJECTS を設定すると「要ログイン」モードになり、ログインID（例: AI-BCP / ASC）ごとに
# 対応する Google Sheet を開く（この場合 SHEET_ID は使われない）。
#   1) AUTH_SECRET … セッション署名・パスワードハッシュの鍵。十分に長いランダム文字列を設定。
#   2) PROJECTS … プロジェクト定義（JSON 1行）。passwordHash は次のコマンドで生成:
#        AUTH_SECRET="（同じ値）" node scripts/hash-password.mjs "設定したいパスワード"
# 例（それぞれ1行で記述）:
# AUTH_SECRET=長いランダム文字列をここに
# PROJECTS={"AI-BCP":{"sheetId":"対象シートID","passwordHash":"生成したハッシュ"},"ASC":{"sheetId":"別シートID","passwordHash":"別ハッシュ"}}
#
# 注意: PROJECTS は本番（Vercel）でも「ビルド時から」環境変数に入れること
#       （ビルド時に要ログイン＝動的描画へ切り替わる判定をするため）。
# サービスアカウントは、PROJECTS に挙げた全シートに対して閲覧者（書き込み時は編集者）で共有する。

# ── v2: PMエージェント（自然言語でのデータ編集）・活動報告メール分析用 ──────
# 実装済み（app/api/assistant + app/api/reports + lib/sheets-write）。「確認してから書き込み」方式。
# ANTHROPIC_API_KEY は「活動報告」ページのメール5W1H分析（/api/reports）でも使用する。
# 未設定の間はアシスタント・メール分析とも「準備中」表示で安全に停止する。
# 有効化には次の2つが必要:
#   1) ANTHROPIC_API_KEY を設定
#   2) サービスアカウントを Google Sheet の「編集者」に昇格（閲覧者のままでは書き込めない）
# ANTHROPIC_API_KEY=sk-ant-...
# 使用モデルを変えたい場合のみ（既定: claude-sonnet-4-6）
# ANTHROPIC_MODEL=claude-sonnet-4-6
